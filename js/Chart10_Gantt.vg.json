{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 740,
    "height": 300,
    "padding": {"left": 0, "top": 5, "right": 5, "bottom": 5},
    "data": {
        "url": "data/ALA_RecordingPrograms.csv",
        "format": {"type": "csv", "parse": {"records": "number", "first_year": "number", "last_year": "number"}
        }
    },
    "transform": [
        {
            "window": [
                {
                    "op": "row_number", "as": "rank"
                }
            ],
            "sort": [{"field": "records", "order": "descending"}]
        },
        {
            "filter": "datum.rank <= 12"
        },
        {
            "calculate": "max(datum.first_year, 1980)",
            "as": "bar_start"
        },
        {
            "calculate": "datum.last_year + 1",
            "as": "bar_end"
        },
        {
            "calculate": "datum.first_year < 1980 ? 'Started before 1980' : 'Started 1980 or later'",
            "as": "start_group"
        }
    ],
    "layer": [
        {
            "mark": {
                "type": "bar",
                "height": {"band": 0.7}
            },
            "encoding": {
                "y": {
                    "field": "short_name",
                    "type": "nominal",
                    "title": null,
                    "sort": {"field": "rank"},
                    "axis": {"labelLimit": 240}
                },
                "x": {
                    "field": "bar_start",
                    "type": "quantitative",
                    "title": "Years the program contributed koala records (number = total records)",
                    "scale": {"domain": [1980, 2030], "nice": false},
                    "axis": {"format": "d", "values": [1980, 1990, 2000, 2010, 2020, 2030], "grid": true}
                },
                "x2": {
                    "field": "bar_end"
                },
                "color": {
                    "field": "start_group",
                    "type": "nominal",
                    "scale": {"domain": ["Started before 1980", "Started 1980 or later"], "range": ["#1F5C3F", "#74B27F"]},
                    "legend": null
                },
                "tooltip": [
                    {
                        "field": "program",
                        "type": "nominal",
                        "title": "Program"
                    },
                    {
                        "field": "first_year",
                        "type": "quantitative",
                        "title": "First koala record",
                        "format": "d"
                    },
                    {
                        "field": "last_year",
                        "type": "quantitative",
                        "title": "Latest koala record",
                        "format": "d"
                    },
                    {
                        "field": "records",
                        "type": "quantitative",
                        "title": "Total records",
                        "format": ","
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.first_year < 1980"
                },
                {
                    "calculate": "'since ' + datum.first_year",
                    "as": "since_label"
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "dx": 4,
                "fontSize": 10,
                "color": "#FFFFFF"
            },
            "encoding": {
                "y": {
                    "field": "short_name",
                    "type": "nominal",
                    "sort": {"field": "rank"}
                },
                "x": {
                    "field": "bar_start",
                    "type": "quantitative"
                },
                "text": {
                    "field": "since_label"
                }
            }
        },
        {
            "mark": {
                "type": "text",
                "align": "left",
                "dx": 4,
                "fontSize": 10,
                "color": "#4F5E55"
            },
            "encoding": {
                "y": {
                    "field": "short_name",
                    "type": "nominal",
                    "sort": {"field": "rank"}
                },
                "x": {
                    "field": "bar_end",
                    "type": "quantitative"
                },
                "text": {
                    "field": "records",
                    "type": "quantitative",
                    "format": ","
                }
            }
        }
    ],
    "config": {
        "view": {
            "stroke": null
        },
        "font": "Public Sans, sans-serif",
        "axis": {
            "labelFontSize": 11,
            "labelColor": "#4F5E55",
            "titleFontSize": 12,
            "titleFontWeight": "normal",
            "titleColor": "#4F5E55",
            "gridColor": "#E3E9E4",
            "domain": false,
            "ticks": false
        }
    }
}
