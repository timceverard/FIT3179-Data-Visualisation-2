{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 540,
    "height": 260,
    "padding": {"left": 0, "top": 5, "right": 5, "bottom": 5},
    "data": {
        "url": "data/QldHospital_RescuesByYearMonthCause.csv",
        "format": {"type": "csv", "parse": {"year": "number", "count": "number", "found_dead": "number", "released": "number"}
        }
    },
    "transform": [
        {
            "aggregate": [
                {
                    "op": "sum", "field": "count", "as": "rescues"
                },
                {
                    "op": "sum", "field": "released", "as": "released"
                },
                {
                    "op": "sum", "field": "found_dead", "as": "found_dead"
                }
            ],
            "groupby": ["year"]
        },
        {
            "calculate": "datum.released / datum.rescues",
            "as": "Released"
        },
        {
            "calculate": "datum.found_dead / datum.rescues",
            "as": "Found dead"
        },
        {
            "fold": ["Released", "Found dead"],
            "as": ["outcome", "share"]
        }
    ],
    "encoding": {
        "x": {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "scale": {"domain": [1997, 2024], "nice": false},
            "axis": {"format": "d", "values": [1997, 2000, 2003, 2006, 2009, 2012, 2015, 2018, 2021, 2024]}
        },
        "y": {
            "field": "share",
            "type": "quantitative",
            "title": "% of rescued koalas",
            "scale": {"domain": [0, 0.5]},
            "axis": {"format": ".0%", "grid": true, "tickCount": 5}
        },
        "color": {
            "field": "outcome",
            "type": "nominal",
            "scale": {"domain": ["Released", "Found dead"], "range": ["#1F5C3F", "#C8862B"]},
            "legend": null
        }
    },
    "layer": [
        {
            "transform": [
                {
                    "filter": "datum.year <= 2024"
                }
            ],
            "mark": {
                "type": "line",
                "strokeWidth": 2.5,
                "point": {"filled": true, "size": 30}
            },
            "encoding": {
                "tooltip": [
                    {
                        "field": "year",
                        "type": "quantitative",
                        "title": "Year",
                        "format": "d"
                    },
                    {
                        "field": "outcome",
                        "type": "nominal",
                        "title": "Outcome"
                    },
                    {
                        "field": "share",
                        "type": "quantitative",
                        "title": "Share of rescues",
                        "format": ".0%"
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.year == 2024 && datum.outcome == 'Released'"
                }
            ],
            "mark": {
                "type": "text",
                "dy": -14,
                "fontSize": 12,
                "fontWeight": 600
            },
            "encoding": {
                "text": {
                    "field": "outcome"
                }
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.year == 2024 && datum.outcome == 'Found dead'"
                }
            ],
            "mark": {
                "type": "text",
                "dy": 16,
                "fontSize": 12,
                "fontWeight": 600
            },
            "encoding": {
                "text": {
                    "field": "outcome"
                }
            }
        }
    ],
    "config": {
        "view": {
            "stroke": null
        },
        "font": "Public Sans, sans-serif",
        "axis": {
            "labelFontSize": 11,
            "labelColor": "#4F5E55",
            "titleFontSize": 12,
            "titleFontWeight": "normal",
            "titleColor": "#4F5E55",
            "gridColor": "#E3E9E4",
            "domain": false,
            "ticks": false
        }
    }
}
